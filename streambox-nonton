<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StreamBox Pro - Modern Cinema</title>
    <style>
        :root {
            --bg-main: #0c0f17;
            --bg-card: #161b26;
            --bg-header: #111622;
            --primary-neon: #00f2fe;
            --secondary-neon: #4facfe;
            --accent-pink: #ff0844;
            --text-main: #ffffff;
            --text-muted: #94a3b8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            background-color: var(--bg-header);
            padding: 0.9rem 2rem;
            border-bottom: 1px solid rgba(0, 242, 254, 0.2);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        header h1 {
            background: linear-gradient(135deg, var(--primary-neon), var(--secondary-neon));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 1.7rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            white-space: nowrap;
            text-transform: uppercase;
            user-select: none;
        }

        .nav-tabs-header {
            display: flex;
            gap: 8px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 0.9rem;
            cursor: pointer;
            padding: 8px 14px;
            font-weight: 600;
            border-radius: 20px;
            transition: all 0.3s ease;
        }

        .tab-btn:hover {
            color: #fff;
        }

        .tab-btn.active {
            background: linear-gradient(135deg, var(--primary-neon), var(--secondary-neon));
            color: #000;
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.4);
        }

        .header-filters {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .search-input-header, .filter-select-header {
            padding: 8px 14px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background-color: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            font-size: 0.85rem;
            outline: none;
            transition: 0.3s ease;
            cursor: pointer;
        }

        select option {
            background-color: #161b26 !important;
            color: #ffffff !important;
            padding: 10px;
        }

        .search-input-header:focus, .filter-select-header:focus {
            border-color: var(--primary-neon);
            box-shadow: 0 0 8px rgba(0, 242, 254, 0.3);
        }

        .search-input-header {
            width: 200px;
        }

        .container {
            max-width: 1280px;
            margin: 1.5rem auto;
            padding: 0 1.2rem;
            width: 100%;
            flex: 1;
        }

        /* Dedicated Watch Mode Modal Container */
        .player-modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(5, 7, 12, 0.95);
            backdrop-filter: blur(10px);
            display: none;
            justify-content: center;
            align-items: flex-start;
            z-index: 1000;
            overflow-y: auto;
            padding: 2rem 1rem;
        }

        .player-card {
            background-color: var(--bg-card);
            border-radius: 12px;
            padding: 1.2rem;
            border: 1px solid rgba(0, 242, 254, 0.3);
            box-shadow: 0 15px 40px rgba(0,0,0,0.8);
            width: 100%;
            max-width: 1000px;
            margin: auto;
            position: relative;
        }

        .btn-back-catalog {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.08);
            color: #fff;
            border: 1px solid rgba(0, 242, 254, 0.4);
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
        }

        .btn-back-catalog:hover {
            background: linear-gradient(135deg, var(--primary-neon), var(--secondary-neon));
            color: #000;
            border-color: transparent;
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.4);
        }

        .video-container {
            position: relative;
            width: 100%;
            padding-top: 56.25%; /* 16:9 Aspect Ratio */
            height: 0;
            overflow: hidden;
            border-radius: 8px;
            background-color: #000;
        }

        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
            outline: none;
            object-fit: contain;
        }

        .server-section {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 15px;
            background: rgba(0,0,0,0.4);
            padding: 10px 15px;
            border-radius: 8px;
            flex-wrap: wrap;
        }

        .server-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--primary-neon);
            text-transform: uppercase;
        }

        .btn-control {
            background: rgba(255,255,255,0.08);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.1);
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            transition: 0.2s;
        }

        .btn-control:hover {
            background: var(--primary-neon);
            color: #000;
        }

        .movie-details {
            margin-top: 15px;
        }

        .badge-container {
            display: flex;
            gap: 8px;
            margin: 10px 0;
            flex-wrap: wrap;
        }

        .badge {
            background: rgba(0, 242, 254, 0.15);
            color: var(--primary-neon);
            border: 1px solid rgba(0, 242, 254, 0.3);
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .section-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 4px solid var(--primary-neon);
            padding-left: 10px;
        }

        .movie-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(165px, 1fr));
            gap: 1.2rem;
        }

        .movie-card {
            background-color: var(--bg-card);
            border-radius: 10px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .movie-card:hover {
            transform: translateY(-7px);
            border-color: var(--primary-neon);
            box-shadow: 0 10px 25px rgba(0, 242, 254, 0.25);
        }

        .poster-wrapper {
            position: relative;
            width: 100%;
            height: 250px;
            overflow: hidden;
            background-color: #121212;
        }

        .movie-poster {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .movie-card:hover .movie-poster {
            transform: scale(1.06);
        }

        .quality-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            color: #ffca28;
            border: 1px solid #ffca28;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .rating-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            color: #fff;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.65rem;
            font-weight: 700;
        }

        .movie-info {
            padding: 12px;
            display: flex;
            flex-direction: column;
            flex: 1;
            justify-content: space-between;
        }

        .movie-info h3 {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 6px;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .movie-meta {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-bottom: 10px;
        }

        .card-actions {
            display: flex;
            gap: 6px;
            flex-direction: column;
        }

        .btn-action {
            background: rgba(255,255,255,0.05);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.1);
            padding: 7px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.75rem;
            font-weight: 600;
            text-align: center;
            transition: 0.2s;
        }

        .btn-action:hover {
            background: linear-gradient(135deg, var(--primary-neon), var(--secondary-neon));
            color: #000;
            border-color: transparent;
        }

        .btn-play-card {
            background: linear-gradient(135deg, var(--primary-neon), var(--secondary-neon));
            color: #000;
            font-weight: 700;
        }

        .btn-edit {
            background: rgba(255, 202, 40, 0.15);
            color: #ffca28;
            border-color: rgba(255, 202, 40, 0.3);
        }

        .btn-edit:hover {
            background: #ffca28;
            color: #000;
        }

        .btn-delete {
            background: rgba(255, 8, 68, 0.2);
            color: #ff4b5c;
            border-color: rgba(255, 8, 68, 0.3);
        }

        .btn-delete:hover {
            background: var(--accent-pink);
            color: #fff;
        }

        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(5px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1100;
            overflow-y: auto;
            padding: 1rem;
        }

        .modal-box {
            background: var(--bg-card);
            padding: 25px;
            border-radius: 12px;
            width: 90%;
            max-width: 550px;
            border: 1px solid rgba(0, 242, 254, 0.3);
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-box h3 {
            margin-bottom: 15px;
            color: var(--primary-neon);
            font-size: 1.2rem;
            text-align: center;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid rgba(255,255,255,0.2);
            background: rgba(0,0,0,0.6);
            color: #ffffff;
            font-size: 0.85rem;
            outline: none;
        }

        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: var(--primary-neon);
        }

        .btn-submit {
            width: 100%;
            background: linear-gradient(135deg, var(--primary-neon), var(--secondary-neon));
            color: #000;
            padding: 10px;
            border: none;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 10px;
        }

        .btn-close {
            background: rgba(255,255,255,0.1);
            color: #fff;
            margin-top: 8px;
        }

        .admin-panel {
            background: var(--bg-card);
            border: 1px solid var(--primary-neon);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 2rem;
            display: none !important;
        }

        .admin-panel.active {
            display: block !important;
        }

        .admin-panel h2 {
            color: var(--primary-neon);
            margin-bottom: 15px;
            font-size: 1.2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        footer {
            text-align: center;
            padding: 2rem;
            background-color: var(--bg-header);
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-top: auto;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body>

    <header>
        <div class="header-left">
            <h1 id="brandLogo" style="cursor: pointer;" title="Klik 3 kali untuk Akses Admin">StreamBox Pro</h1>
            <div class="nav-tabs-header">
                <button class="tab-btn active" onclick="switchTab('all', this)">Semua Film</button>
                <button class="tab-btn" onclick="switchTab('watchlist', this)">⭐ Favorit (<span id="wlCount">0</span>)</button>
            </div>
        </div>

        <div class="header-filters">
            <input type="text" id="searchInput" class="search-input-header" placeholder="🔍 Cari judul film..." oninput="applyFilters()">
            
            <!-- Genre Filter -->
            <select id="genreFilter" class="filter-select-header" onchange="applyFilters()">
                <option value="all">Semua Genre</option>
                <option value="Action">Action</option>
                <option value="Adventure">Adventure</option>
                <option value="Anime">Anime</option>
                <option value="Animation">Animation</option>
                <option value="Comedy">Comedy</option>
                <option value="Crime">Crime</option>
                <option value="Documentary">Documentary</option>
                <option value="Drama">Drama</option>
                <option value="Family">Family</option>
                <option value="Fantasy">Fantasy</option>
                <option value="History">History</option>
                <option value="Horror">Horror</option>
                <option value="Mystery">Mystery</option>
                <option value="Romance">Romance</option>
                <option value="Sci-Fi">Sci-Fi</option>
                <option value="Thriller">Thriller</option>
            </select>

            <!-- Country Filter -->
            <select id="countryFilter" class="filter-select-header" onchange="applyFilters()">
                <option value="all">Semua Negara</option>
                <option value="Jepang">Jepang</option>
                <option value="Indonesia">Indonesia</option>
                <option value="Korea Selatan">Korea Selatan</option>
                <option value="Amerika Serikat">Amerika Serikat (USA)</option>
                <option value="China">China</option>
                <option value="Thailand">Thailand</option>
                <option value="India">India</option>
                <option value="Inggris">Inggris (UK)</option>
            </select>

            <!-- Year Filter -->
            <select id="yearFilter" class="filter-select-header" onchange="applyFilters()">
                <option value="all">Semua Tahun</option>
                <option value="2026">2026</option>
                <option value="2025">2025</option>
                <option value="2024">2024</option>
                <option value="2023">2023</option>
                <option value="2022">2022</option>
            </select>
        </div>
    </header>

    <div class="container">

        <!-- Admin Control Panel -->
        <div class="admin-panel" id="adminPanel">
            <h2>
                <span>👑 Panel Pengelola Admin</span>
                <button class="btn-action" style="background:#333;" onclick="logoutAdmin()">Keluar Admin</button>
            </h2>
            <form id="addMovieForm" onsubmit="handleAddMovie(event)">
                <div class="admin-grid">
                    <div class="form-group">
                        <label>Judul Film:</label>
                        <input type="text" id="addTitle" required placeholder="Contoh: Cyberpunk Knights">
                    </div>
                    <div class="form-group">
                        <label>Genre:</label>
                        <select id="addGenre">
                            <option value="Action">Action</option>
                            <option value="Adventure">Adventure</option>
                            <option value="Anime">Anime</option>
                            <option value="Animation">Animation</option>
                            <option value="Comedy">Comedy</option>
                            <option value="Crime">Crime</option>
                            <option value="Documentary">Documentary</option>
                            <option value="Drama">Drama</option>
                            <option value="Family">Family</option>
                            <option value="Fantasy">Fantasy</option>
                            <option value="History">History</option>
                            <option value="Horror">Horror</option>
                            <option value="Mystery">Mystery</option>
                            <option value="Romance">Romance</option>
                            <option value="Sci-Fi">Sci-Fi</option>
                            <option value="Thriller">Thriller</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Tahun Rilis:</label>
                        <input type="text" id="addYear" placeholder="2026" required>
                    </div>
                    <div class="form-group">
                        <label>Negara Asal:</label>
                        <select id="addCountry">
                            <option value="Jepang">Jepang</option>
                            <option value="Indonesia">Indonesia</option>
                            <option value="Korea Selatan">Korea Selatan</option>
                            <option value="Amerika Serikat">Amerika Serikat</option>
                            <option value="China">China</option>
                            <option value="Thailand">Thailand</option>
                            <option value="India">India</option>
                            <option value="Inggris">Inggris</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Rating:</label>
                        <input type="text" id="addRating" placeholder="8.5">
                    </div>

                    <div class="form-group">
                        <label>Upload Gambar Poster (JPG/PNG):</label>
                        <input type="file" id="addPosterFile" accept="image/*">
                    </div>
                    <div class="form-group">
                        <label>Atau URL Gambar (Opsional):</label>
                        <input type="url" id="addPosterUrl" placeholder="https://...">
                    </div>
                </div>

                <div class="admin-grid" style="margin-top: 10px;">
                    <div class="form-group">
                        <label>Link Embed Nonton (Server 1):</label>
                        <input type="url" id="addServer1" placeholder="https://dood.to/e/..." required>
                    </div>
                    <div class="form-group">
                        <label>Link Download (Doodstream):</label>
                        <input type="url" id="addDoodstream" placeholder="https://dood.to/d/...">
                    </div>
                    <div class="form-group">
                        <label>Link Download (Terabox):</label>
                        <input type="url" id="addTerabox" placeholder="https://terabox.com/s/...">
                    </div>
                </div>

                <div class="admin-grid" style="margin-top: 10px;">
                    <div class="form-group">
                        <label>Pemain / Cast:</label>
                        <input type="text" id="addCast" placeholder="Nama pemeran">
                    </div>
                </div>

                <div class="form-group" style="margin-top: 10px;">
                    <label>Sinopsis:</label>
                    <textarea id="addSynopsis" rows="2" placeholder="Ringkasan alur cerita..."></textarea>
                </div>

                <button type="submit" class="btn-submit">➕ Tambah Film Ke Katalog</button>
            </form>

            <div style="margin-top: 20px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; gap: 10px; flex-wrap: wrap;">
                <button type="button" class="btn-action" style="flex:1;" onclick="exportData()">💾 Cadangkan Data Film (Export JSON)</button>
                <input type="file" id="importFile" accept=".json" style="display:none;" onchange="importData(event)">
                <button type="button" class="btn-action" style="flex:1;" onclick="document.getElementById('importFile').click()">📂 Pulihkan Data Film (Import JSON)</button>
            </div>
        </div>

        <!-- Catalog Grid Title & Container -->
        <div class="section-title">KATALOG FILM TERBARU</div>
        <div class="movie-grid" id="movieGrid"></div>
    </div>

    <!-- Dedicated Full Screen / Modal Watch Player Overlay -->
    <div class="player-modal-overlay" id="playerModalOverlay">
        <div class="player-card">
            <button class="btn-back-catalog" onclick="closePlayerModal()">
                ← Kembali ke Katalog
            </button>

            <div class="video-container">
                <iframe id="videoPlayer" src="" allowfullscreen scrolling="no"></iframe>
            </div>

            <div class="server-section">
                <span class="server-title">📡 Server:</span>
                <div id="serverButtons" style="display: flex; gap: 8px; flex-wrap: wrap;"></div>
            </div>

            <div style="display:flex; justify-content:space-between; margin-top:12px; align-items:center; flex-wrap:wrap; gap:10px;">
                <div style="font-size:0.8rem; color:var(--primary-neon);" id="syncStatus">
                    ✓ Memutar tayangan
                </div>
                <button class="btn-control" onclick="openDownloadModal()">📥 Download Film</button>
            </div>

            <div class="movie-details" id="movieDetails">
                <h2 id="activeTitle" style="font-size:1.4rem;"></h2>
                <div class="badge-container" id="activeBadges"></div>
                <p id="activeRating" style="font-size:0.85rem; color:var(--text-muted);"></p>
                <p id="activeCast" style="font-size:0.85rem; color:var(--text-muted);"></p>
                <p id="activeSynopsis" style="margin-top: 10px; font-size:0.9rem; line-height:1.5; color: #cbd5e1;"></p>
            </div>
        </div>
    </div>

    <!-- Modal Edit Movie Admin -->
    <div class="modal-overlay" id="editMovieModal">
        <div class="modal-box">
            <h3>✏️ Edit Data Film</h3>
            <form id="editMovieForm" onsubmit="handleSaveEditMovie(event)">
                <input type="hidden" id="editMovieId">
                <div class="form-group">
                    <label>Judul Film:</label>
                    <input type="text" id="editTitle" required>
                </div>
                <div class="form-group">
                    <label>Genre:</label>
                    <select id="editGenre">
                        <option value="Action">Action</option>
                        <option value="Adventure">Adventure</option>
                        <option value="Anime">Anime</option>
                        <option value="Animation">Animation</option>
                        <option value="Comedy">Comedy</option>
                        <option value="Crime">Crime</option>
                        <option value="Documentary">Documentary</option>
                        <option value="Drama">Drama</option>
                        <option value="Family">Family</option>
                        <option value="Fantasy">Fantasy</option>
                        <option value="History">History</option>
                        <option value="Horror">Horror</option>
                        <option value="Mystery">Mystery</option>
                        <option value="Romance">Romance</option>
                        <option value="Sci-Fi">Sci-Fi</option>
                        <option value="Thriller">Thriller</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Tahun Rilis:</label>
                    <input type="text" id="editYear" required>
                </div>
                <div class="form-group">
                    <label>Negara Asal:</label>
                    <select id="editCountry">
                        <option value="Jepang">Jepang</option>
                        <option value="Indonesia">Indonesia</option>
                        <option value="Korea Selatan">Korea Selatan</option>
                        <option value="Amerika Serikat">Amerika Serikat</option>
                        <option value="China">China</option>
                        <option value="Thailand">Thailand</option>
                        <option value="India">India</option>
                        <option value="Inggris">Inggris</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Rating:</label>
                    <input type="text" id="editRating">
                </div>

                <div class="form-group">
                    <label>Ganti Poster File (Opsional):</label>
                    <input type="file" id="editPosterFile" accept="image/*">
                </div>
                <div class="form-group">
                    <label>Atau Ganti URL Gambar Poster (Opsional):</label>
                    <input type="url" id="editPosterUrl" placeholder="Biarkan kosong jika tak ingin mengubah poster">
                </div>

                <div class="form-group">
                    <label>Link Embed Nonton (Server 1):</label>
                    <input type="url" id="editServer1" required>
                </div>
                <div class="form-group">
                    <label>Link Download (Doodstream):</label>
                    <input type="url" id="editDoodstream">
                </div>
                <div class="form-group">
                    <label>Link Download (Terabox):</label>
                    <input type="url" id="editTerabox">
                </div>

                <div class="form-group">
                    <label>Pemain / Cast:</label>
                    <input type="text" id="editCast">
                </div>

                <div class="form-group">
                    <label>Sinopsis:</label>
                    <textarea id="editSynopsis" rows="3"></textarea>
                </div>

                <button type="submit" class="btn-submit">💾 Simpan Perubahan</button>
                <button type="button" class="btn-submit btn-close" onclick="closeEditModal()">Batal</button>
            </form>
        </div>
    </div>

    <!-- Modal Login Admin -->
    <div class="modal-overlay" id="authModal">
        <div class="modal-box">
            <h3>🔐 Login Khusus Admin</h3>
            <p style="font-size: 0.8rem; color: var(--text-muted); text-align:center; margin-bottom: 15px;">Masukkan PIN akses admin.</p>
            <div class="form-group">
                <label>PIN Admin:</label>
                <input type="password" id="adminPinInput" placeholder="PIN..." autofocus>
            </div>
            <button class="btn-submit" onclick="loginAdmin()">Masuk Panel</button>
            <button class="btn-submit btn-close" onclick="toggleAuthModal()">Batal</button>
        </div>
    </div>

    <!-- Download Options Modal -->
    <div class="modal-overlay" id="downloadModal">
        <div class="modal-box">
            <h3>📥 Pilih Provider Download</h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); text-align:center; margin-bottom: 15px;" id="dlMovieTitle">Silakan pilih penyedia layanan unduhan:</p>
            
            <button class="btn-submit" id="btnDlDoodstream" onclick="triggerDownload('doodstream')" style="margin-bottom: 10px; background: linear-gradient(135deg, #00f2fe, #4facfe);">
                🚀 Download via Doodstream
            </button>
            <button class="btn-submit" id="btnDlTerabox" onclick="triggerDownload('terabox')" style="margin-bottom: 10px; background: linear-gradient(135deg, #00c6ff, #0072ff); color: white;">
                📦 Download via Terabox
            </button>
            
            <button class="btn-submit btn-close" onclick="closeDownloadModal()">Batal</button>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 StreamBox Pro - High Performance Cinema Streaming</p>
    </footer>

    <script>
        const ADMIN_PIN = "amegafuru62";
        let isAdminLoggedIn = false;

        const defaultMovies = [
            {
                id: 101,
                title: "Cyberpunk Knights 2077",
                genre: "Sci-Fi",
                year: "2026",
                country: "Jepang",
                rating: "8.5",
                cast: "Ahmad, Sarah",
                synopsis: "Pertarungan peretas melawan megakorporasi jahat di era neon.",
                poster: "https://placehold.co/300x450/161b26/00f2fe?text=Cyberpunk+Knights",
                doodstream: "https://dood.to/d/xxxxx1",
                terabox: "https://terabox.com/s/xxxxx1",
                servers: [
                    { name: "Server Utama", url: "https://dood.to/e/xxxxx1" }
                ]
            }
        ];

        let moviesList = JSON.parse(localStorage.getItem('customMovies')) || defaultMovies;
        let currentMovieIndex = -1;
        let activeServerIndex = 0;
        let watchlist = JSON.parse(localStorage.getItem('myWatchlist')) || [];
        let currentTab = 'all';

        function init() {
            renderMovies(moviesList);
            updateWatchlistCount();
        }

        function toggleAuthModal() {
            const modal = document.getElementById('authModal');
            modal.style.display = (modal.style.display === 'flex') ? 'none' : 'flex';
            if (modal.style.display === 'flex') {
                document.getElementById('adminPinInput').focus();
            }
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'F2' || (e.shiftKey && (e.key === 'A' || e.key === 'a'))) {
                e.preventDefault();
                toggleAuthModal();
            }
        });

        let logoClickCount = 0;
        let logoClickTimer;
        document.getElementById('brandLogo').addEventListener('click', function() {
            logoClickCount++;
            clearTimeout(logoClickTimer);
            if (logoClickCount === 3) {
                toggleAuthModal();
                logoClickCount = 0;
            } else {
                logoClickTimer = setTimeout(() => { logoClickCount = 0; }, 1000);
            }
        });

        function loginAdmin() {
            const pin = document.getElementById('adminPinInput').value;
            if (pin === ADMIN_PIN) {
                isAdminLoggedIn = true;
                document.getElementById('adminPanel').classList.add('active');
                toggleAuthModal();
                renderMovies(moviesList);
                alert("Akses Admin Diberikan!");
            } else {
                alert("PIN Admin Salah!");
            }
            document.getElementById('adminPinInput').value = '';
        }

        function logoutAdmin() {
            isAdminLoggedIn = false;
            document.getElementById('adminPanel').classList.remove('active');
            renderMovies(moviesList);
            alert("Keluar dari Mode Admin.");
        }

        function handleAddMovie(e) {
            e.preventDefault();

            const fileInput = document.getElementById('addPosterFile');
            const urlInput = document.getElementById('addPosterUrl').value;

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    saveMovieData(event.target.result);
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else if (urlInput.trim() !== '') {
                saveMovieData(urlInput);
            } else {
                alert("Harap pilih file gambar poster (JPG/PNG) atau masukkan URL gambar!");
            }
        }

        function saveMovieData(posterSrc) {
            const newMovie = {
                id: Date.now(),
                title: document.getElementById('addTitle').value,
                genre: document.getElementById('addGenre').value,
                year: document.getElementById('addYear').value,
                country: document.getElementById('addCountry').value,
                rating: document.getElementById('addRating').value || "8.0",
                cast: document.getElementById('addCast').value || "-",
                synopsis: document.getElementById('addSynopsis').value || "Belum ada sinopsis.",
                poster: posterSrc,
                doodstream: document.getElementById('addDoodstream').value,
                terabox: document.getElementById('addTerabox').value,
                servers: [
                    { 
                        name: "Server Utama", 
                        url: document.getElementById('addServer1').value 
                    }
                ]
            };

            moviesList.unshift(newMovie);
            localStorage.setItem('customMovies', JSON.stringify(moviesList));
            renderMovies(moviesList);
            document.getElementById('addMovieForm').reset();
            alert(`Film "${newMovie.title}" berhasil ditambahkan!`);
        }

        function openEditModal(id) {
            const movie = moviesList.find(m => m.id === id);
            if (!movie) return;

            document.getElementById('editMovieId').value = movie.id;
            document.getElementById('editTitle').value = movie.title || '';
            document.getElementById('editGenre').value = movie.genre || 'Action';
            document.getElementById('editYear').value = movie.year || '';
            document.getElementById('editCountry').value = movie.country || 'Jepang';
            document.getElementById('editRating').value = movie.rating || '';
            document.getElementById('editPosterUrl').value = '';
            document.getElementById('editPosterFile').value = '';
            
            const serverUrl = movie.servers && movie.servers[0] ? movie.servers[0].url : '';
            document.getElementById('editServer1').value = serverUrl;
            document.getElementById('editDoodstream').value = movie.doodstream || '';
            document.getElementById('editTerabox').value = movie.terabox || '';
            document.getElementById('editCast').value = movie.cast || '';
            document.getElementById('editSynopsis').value = movie.synopsis || '';

            document.getElementById('editMovieModal').style.display = 'flex';
        }

        function closeEditModal() {
            document.getElementById('editMovieModal').style.display = 'none';
            document.getElementById('editMovieForm').reset();
        }

        function handleSaveEditMovie(e) {
            e.preventDefault();
            const id = parseInt(document.getElementById('editMovieId').value, 10);
            const index = moviesList.findIndex(m => m.id === id);

            if (index === -1) {
                alert("Film tidak ditemukan!");
                return;
            }

            const fileInput = document.getElementById('editPosterFile');
            const urlInput = document.getElementById('editPosterUrl').value.trim();

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    commitMovieEdit(index, event.target.result);
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else if (urlInput !== '') {
                commitMovieEdit(index, urlInput);
            } else {
                // Keep existing poster if no new input provided
                commitMovieEdit(index, moviesList[index].poster);
            }
        }

        function commitMovieEdit(index, posterSrc) {
            moviesList[index].title = document.getElementById('editTitle').value;
            moviesList[index].genre = document.getElementById('editGenre').value;
            moviesList[index].year = document.getElementById('editYear').value;
            moviesList[index].country = document.getElementById('editCountry').value;
            moviesList[index].rating = document.getElementById('editRating').value || "8.0";
            moviesList[index].poster = posterSrc;
            moviesList[index].doodstream = document.getElementById('editDoodstream').value;
            moviesList[index].terabox = document.getElementById('editTerabox').value;
            moviesList[index].cast = document.getElementById('editCast').value || "-";
            moviesList[index].synopsis = document.getElementById('editSynopsis').value || "Belum ada sinopsis.";
            
            const serverUrl = document.getElementById('editServer1').value;
            if (!moviesList[index].servers || moviesList[index].servers.length === 0) {
                moviesList[index].servers = [{ name: "Server Utama", url: serverUrl }];
            } else {
                moviesList[index].servers[0].url = serverUrl;
            }

            localStorage.setItem('customMovies', JSON.stringify(moviesList));
            renderMovies(moviesList);
            closeEditModal();
            alert(`Film "${moviesList[index].title}" berhasil diperbarui!`);
        }

        function deleteMovie(id) {
            if (confirm("Hapus film ini dari katalog?")) {
                moviesList = moviesList.filter(m => m.id !== id);
                localStorage.setItem('customMovies', JSON.stringify(moviesList));
                renderMovies(moviesList);
            }
        }

        function renderMovies(list) {
            const grid = document.getElementById('movieGrid');
            grid.innerHTML = '';

            if (list.length === 0) {
                grid.innerHTML = '<p style="color:var(--text-muted); grid-column: 1/-1; text-align:center; padding: 2rem 0;">Tidak ada film ditemukan.</p>';
                return;
            }

            list.forEach((movie) => {
                const isSaved = watchlist.includes(movie.id);
                const card = document.createElement('div');
                card.className = 'movie-card';
                card.innerHTML = `
                    <div class="poster-wrapper">
                        <span class="quality-badge">HD</span>
                        <span class="rating-badge">⭐ ${movie.rating}</span>
                        <img src="${movie.poster}" alt="${movie.title}" class="movie-poster" onerror="this.src='https://placehold.co/300x450/161b26/ffffff?text=No+Poster'">
                    </div>
                    <div class="movie-info">
                        <div>
                            <h3>${movie.title}</h3>
                            <p class="movie-meta">${movie.genre} • ${movie.year}</p>
                        </div>
                        <div class="card-actions">
                            <button class="btn-action btn-play-card" onclick="playMovie(${movie.id})">▶ Nonton</button>
                            <button class="btn-action" style="background:rgba(255,255,255,0.03);" onclick="toggleWatchlist(${movie.id})">
                                ${isSaved ? '❌ Batal' : '⭐ +Favorit'}
                            </button>
                            ${isAdminLoggedIn ? `
                                <button class="btn-action btn-edit" onclick="openEditModal(${movie.id})">✏️ Edit</button>
                                <button class="btn-action btn-delete" onclick="deleteMovie(${movie.id})">🗑 Hapus</button>
                            ` : ''}
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function playMovie(id, serverIndex = 0) {
            const movie = moviesList.find(m => m.id === id);
            if (!movie) return;

            currentMovieIndex = moviesList.findIndex(m => m.id === id);
            activeServerIndex = serverIndex;

            let targetUrl = movie.servers && movie.servers[serverIndex] ? movie.servers[serverIndex].url : (movie.servers && movie.servers[0] ? movie.servers[0].url : "");
            document.getElementById('videoPlayer').src = targetUrl;
            document.getElementById('activeTitle').innerText = movie.title;

            document.getElementById('activeBadges').innerHTML = `
                <span class="badge">${movie.genre}</span>
                <span class="badge">${movie.year}</span>
                <span class="badge">${movie.country}</span>
            `;
            document.getElementById('activeRating').innerText = "Rating IMDb: ⭐ " + movie.rating;
            document.getElementById('activeCast').innerText = "Pemeran: " + movie.cast;
            document.getElementById('activeSynopsis').innerText = movie.synopsis;

            // Render Server Switcher Buttons
            const serverContainer = document.getElementById('serverButtons');
            serverContainer.innerHTML = '';
            if (movie.servers) {
                movie.servers.forEach((srv, idx) => {
                    const btn = document.createElement('button');
                    btn.className = 'btn-control';
                    if (idx === activeServerIndex) {
                        btn.style.background = 'var(--primary-neon)';
                        btn.style.color = '#000';
                    }
                    btn.innerText = srv.name || `Server ${idx + 1}`;
                    btn.onclick = () => playMovie(id, idx);
                    serverContainer.appendChild(btn);
                });
            }

            // Display Dedicated Player Overlay Modal
            document.getElementById('playerModalOverlay').style.display = 'flex';
        }

        function closePlayerModal() {
            document.getElementById('playerModalOverlay').style.display = 'none';
            document.getElementById('videoPlayer').src = "";
        }

        function openDownloadModal() {
            if (currentMovieIndex === -1) return;
            const movie = moviesList[currentMovieIndex];
            if (!movie) {
                alert("Pilih film yang ingin diunduh terlebih dahulu!");
                return;
            }

            document.getElementById('dlMovieTitle').innerText = `Pilih server download untuk "${movie.title}":`;
            
            const btnDood = document.getElementById('btnDlDoodstream');
            const btnTera = document.getElementById('btnDlTerabox');

            btnDood.style.display = movie.doodstream ? 'block' : 'none';
            btnTera.style.display = movie.terabox ? 'block' : 'none';

            if (!movie.doodstream && !movie.terabox) {
                alert("Maaf, link unduhan belum tersedia untuk film ini.");
                return;
            }

            document.getElementById('downloadModal').style.display = 'flex';
        }

        function closeDownloadModal() {
            document.getElementById('downloadModal').style.display = 'none';
        }

        function triggerDownload(provider) {
            if (currentMovieIndex === -1) return;
            const movie = moviesList[currentMovieIndex];
            if (!movie) return;

            let link = "";
            if (provider === 'doodstream') link = movie.doodstream;
            if (provider === 'terabox') link = movie.terabox;

            if (link) {
                window.open(link, '_blank');
                closeDownloadModal();
            } else {
                alert("Link unduhan tidak tersedia.");
            }
        }

        function toggleWatchlist(id) {
            if (watchlist.includes(id)) {
                watchlist = watchlist.filter(item => item !== id);
            } else {
                watchlist.push(id);
            }
            localStorage.setItem('myWatchlist', JSON.stringify(watchlist));
            updateWatchlistCount();
            applyFilters();
        }

        function updateWatchlistCount() {
            document.getElementById('wlCount').innerText = watchlist.length;
        }

        function applyFilters() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const selectedGenre = document.getElementById('genreFilter').value;
            const selectedCountry = document.getElementById('countryFilter').value;
            const selectedYear = document.getElementById('yearFilter').value;

            let filtered = moviesList.filter(m => {
                const matchesSearch = (m.title && m.title.toLowerCase().includes(query)) || (m.cast && m.cast.toLowerCase().includes(query));
                const matchesGenre = selectedGenre === 'all' || m.genre === selectedGenre;
                const matchesCountry = selectedCountry === 'all' || m.country === selectedCountry;
                const matchesYear = selectedYear === 'all' || m.year === selectedYear;
                const matchesTab = currentTab === 'all' ? true : watchlist.includes(m.id);

                return matchesSearch && matchesGenre && matchesCountry && matchesYear && matchesTab;
            });

            renderMovies(filtered);
        }

        function switchTab(tab, btn) {
            currentTab = tab;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            applyFilters();
        }

        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(moviesList));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "cadangan_film_streambox.json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importData(event) {
            const fileReader = new FileReader();
            fileReader.onload = function(e) {
                try {
                    const importedMovies = JSON.parse(e.target.result);
                    if (Array.isArray(importedMovies)) {
                        moviesList = importedMovies;
                        localStorage.setItem('customMovies', JSON.stringify(moviesList));
                        renderMovies(moviesList);
                        alert("Data film berhasil diimpor!");
                    } else {
                        alert("Format file tidak sesuai!");
                    }
                } catch (err) {
                    alert("Gagal membaca file cadangan.");
                }
            };
            fileReader.readAsText(event.target.files[0]);
        }

        window.onload = init;
    </script>
</body>
</html>
